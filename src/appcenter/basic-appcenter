#!/bin/sh
# ================================================
#  basic OS - App Center (dialog GUI)
# ================================================

export TERM=linux
DIALOG="/usr/bin/dialog"
APP_DIR="/usr/share/basic-apps"
APP_LIST="$APP_DIR/apps.list"
APP_DATA="$APP_DIR/apps"
BACKTITLE="basic OS App Center"

mkdir -p "$APP_DIR" "$APP_DATA"

# Init app list
if [ ! -f "$APP_LIST" ]; then
    cat > "$APP_LIST" << 'EOF'
# basic OS App Center
# name|version|description|category|size|url
hello|1.0.0|A simple hello world demo|Demo|1K|https://raw.githubusercontent.com/basic-os/apps/main/hello/hello-1.0.0.tar.gz
busybox-extras|1.36.1|Extra BusyBox applets|System|2M|https://raw.githubusercontent.com/basic-os/apps/main/busybox-extras/busybox-extras-1.36.1.tar.gz
dropbear|2022.83|Lightweight SSH server|Network|500K|https://raw.githubusercontent.com/basic-os/apps/main/dropbear/dropbear-2022.83.tar.gz
htop|3.3.0|Interactive process viewer|System|300K|https://raw.githubusercontent.com/basic-os/apps/main/htop/htop-3.3.0.tar.gz
nano|7.2|Simple text editor|Editor|700K|https://raw.githubusercontent.com/basic-os/apps/main/nano/nano-7.2.tar.gz
lynx|2.9.0|Text-based web browser|Network|2M|https://raw.githubusercontent.com/basic-os/apps/main/lynx/lynx-2.9.0.tar.gz
python-mini|3.11.0|Minimal Python interpreter|Dev|5M|https://raw.githubusercontent.com/basic-os/apps/main/python-mini/python-mini-3.11.0.tar.gz
EOF
fi

# ====== Functions ======

show_main_menu() {
    while true; do
        CHOICE=$($DIALOG --backtitle "$BACKTITLE" --title "App Center" \
          --menu "\nWelcome to basic OS App Center\n\nChoose an action:" 18 55 8 \
          "1" "Browse all available apps" \
          "2" "Install an app" \
          "3" "Remove an installed app" \
          "4" "View installed apps" \
          "5" "Search for apps" \
          "6" "Update app list" \
          "7" "About basic OS" \
          "8" "Exit" 2>&1 >/dev/tty)

        [ $? -ne 0 ] && break

        case "$CHOICE" in
            1) browse_apps ;;
            2) install_app_dialog ;;
            3) remove_app_dialog ;;
            4) show_installed ;;
            5) search_apps ;;
            6) update_list ;;
            7) show_about ;;
            8) break ;;
            *) break ;;
        esac
    done
    clear
}

browse_apps() {
    local applist=""
    local idx=1
    while IFS='|' read -r name version desc category size url; do
        [ -z "$name" ] && continue
        [ "${name:0:1}" = "#" ] && continue
        local mark=""
        [ -f "$APP_DATA/$name.installed" ] && mark="[INSTALLED]"
        applist="$applist \"$idx\" \"$name  $version  $mark\" \"$desc  ($category, $size)\""
        idx=$((idx + 1))
    done < "$APP_LIST"

    if [ -z "$applist" ]; then
        $DIALOG --backtitle "$BACKTITLE" --title "Browse" --msgbox "No apps available." 6 40
        return
    fi

    eval $DIALOG --backtitle \"$BACKTITLE\" --title \"Browse Apps\" \
      --menu \"\\nAvailable applications:\\n\" 20 65 12 $applist 2>&1 >/dev/tty
}

install_app_dialog() {
    local names=""
    while IFS='|' read -r name version desc category size url; do
        [ -z "$name" ] && continue
        [ "${name:0:1}" = "#" ] && continue
        [ -f "$APP_DATA/$name.installed" ] && continue
        names="$names \"$name\" \"$desc ($category, $size)\""
    done < "$APP_LIST"

    if [ -z "$names" ]; then
        $DIALOG --backtitle "$BACKTITLE" --title "Install" --msgbox "All apps are already installed!" 6 45
        return
    fi

    APP=$(eval $DIALOG --backtitle \"$BACKTITLE\" --title \"Install App\" \
      --menu \"\\nSelect an app to install:\\n\" 18 60 10 $names 2>&1 >/dev/tty)

    [ -z "$APP" ] && return

    # Get URL
    URL=$(grep "^$APP|" "$APP_LIST" | cut -d'|' -f6)
    VER=$(grep "^$APP|" "$APP_LIST" | cut -d'|' -f2)

    $DIALOG --backtitle "$BACKTITLE" --title "Installing" \
      --gauge "\nDownloading and installing $APP $VER...\n" 6 50 0 &

    mkdir -p "/tmp/app-install-$APP"
    cd "/tmp/app-install-$APP"

    if wget -q -O "$APP.tar.gz" "$URL" 2>/dev/null; then
        tar xzf "$APP.tar.gz" 2>/dev/null
        [ -d "rootfs" ] && cp -a rootfs/* / 2>/dev/null
        [ -f "install.sh" ] && sh install.sh
        echo "$VER" > "$APP_DATA/$APP.installed"
        wait
        $DIALOG --backtitle "$BACKTITLE" --title "Success" \
          --msgbox "$APP $VER installed successfully!" 6 50
    else
        wait
        $DIALOG --backtitle "$BACKTITLE" --title "Error" \
          --msgbox "Failed to download $APP.\nCheck network connection." 7 45
    fi

    cd /
    rm -rf "/tmp/app-install-$APP"
}

remove_app_dialog() {
    local names=""
    for f in "$APP_DATA"/*.installed; do
        [ -f "$f" ] || continue
        local name=$(basename "$f" .installed)
        names="$names \"$name\" \"\""
    done

    if [ -z "$names" ]; then
        $DIALOG --backtitle "$BACKTITLE" --title "Remove" --msgbox "No apps installed." 6 40
        return
    fi

    APP=$(eval $DIALOG --backtitle \"$BACKTITLE\" --title \"Remove App\" \
      --menu \"\\nSelect an app to remove:\\n\" 14 45 8 $names 2>&1 >/dev/tty)

    [ -z "$APP" ] && return

    $DIALOG --backtitle "$BACKTITLE" --title "Confirm" \
      --yesno "Remove $APP?" 6 35
    [ $? -eq 0 ] && rm -f "$APP_DATA/$APP.installed"
}

show_installed() {
    local text=""
    for f in "$APP_DATA"/*.installed; do
        [ -f "$f" ] || continue
        local name=$(basename "$f" .installed)
        local ver=$(cat "$f")
        text="$text\n  $name  v$ver"
    done

    if [ -z "$text" ]; then
        text="\n  No apps installed."
    fi

    $DIALOG --backtitle "$BACKTITLE" --title "Installed Apps" \
      --msgbox "$text" 14 45
}

search_apps() {
    QUERY=$($DIALOG --backtitle "$BACKTITLE" --title "Search" \
      --inputbox "Enter search keyword:" 8 40 2>&1 >/dev/tty)

    [ -z "$QUERY" ] && return

    local results=""
    grep -i "$QUERY" "$APP_LIST" | grep -v '^#' | while IFS='|' read -r name version desc category size url; do
        [ -z "$name" ] && continue
        local mark=""
        [ -f "$APP_DATA/$name.installed" ] && mark=" [INSTALLED]"
        results="$results\n  $name  v$version  ($category)$mark\n    $desc\n"
    done

    if [ -z "$results" ]; then
        $DIALOG --backtitle "$BACKTITLE" --title "Search" \
          --msgbox "No results for '$QUERY'." 6 40
    else
        echo "$results" > /tmp/search-results.txt
        $DIALOG --backtitle "$BACKTITLE" --title "Search Results" \
          --textbox /tmp/search-results.txt 16 60
        rm -f /tmp/search-results.txt
    fi
}

update_list() {
    $DIALOG --backtitle "$BACKTITLE" --title "Update" \
      --gauge "Updating app list..." 6 50 0 &
    if wget -q -O "$APP_LIST.new" "https://raw.githubusercontent.com/basic-os/apps/main/apps.list" 2>/dev/null; then
        mv "$APP_LIST.new" "$APP_LIST"
        wait
        $DIALOG --backtitle "$BACKTITLE" --title "Update" --msgbox "App list updated!" 6 40
    else
        wait
        $DIALOG --backtitle "$BACKTITLE" --title "Update" --msgbox "Update failed.\nCheck network." 7 40
    fi
}

show_about() {
    $DIALOG --backtitle "$BACKTITLE" --title "About basic OS" \
      --msgbox "\nbasic OS v1.0\n\nLinux Kernel 7.1.6\nBusyBox 1.36.1\n\nA minimal Linux operating system\nwith graphical installer and\napp center.\n\nhttps://github.com/HuHuBasic/Basic-OS" 16 55
}

# ====== Main ======
show_main_menu