#!/bin/sh
# ================================================
#  basic OS - App Center (应用中心)
#  Simple package manager for basic OS
# ================================================

APP_DIR="/usr/share/basic-apps"
APP_LIST="$APP_DIR/apps.list"
APP_DATA="$APP_DIR/apps"
APP_REPO="https://raw.githubusercontent.com/basic-os/apps/main"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Ensure app directory exists
mkdir -p "$APP_DIR" "$APP_DATA"

# Initialize app list
if [ ! -f "$APP_LIST" ]; then
    cat > "$APP_LIST" << 'EOF'
# basic OS App Center - Application List
# Format: name|version|description|category|size|url
hello|1.0.0|A simple hello world program|demo|4K|${APP_REPO}/hello/hello-1.0.0.tar.gz
busybox-extras|1.36.1|Extra BusyBox applets|system|2M|${APP_REPO}/busybox-extras/busybox-extras-1.36.1.tar.gz
dropbear|2022.83|Lightweight SSH server|network|500K|${APP_REPO}/dropbear/dropbear-2022.83.tar.gz
htop|3.3.0|Interactive process viewer|system|300K|${APP_REPO}/htop/htop-3.3.0.tar.gz
nano|7.2|Simple text editor|editor|700K|${APP_REPO}/nano/nano-7.2.tar.gz
lynx|2.9.0|Text-based web browser|network|2M|${APP_REPO}/lynx/lynx-2.9.0.tar.gz
python-mini|3.11.0|Minimal Python interpreter|dev|5M|${APP_REPO}/python-mini/python-mini-3.11.0.tar.gz
EOF
fi

# ====== Functions ======

show_banner() {
    echo ""
    echo -e "${CYAN}  ==========================================${NC}"
    echo -e "${CYAN}    basic OS App Center (应用中心)${NC}"
    echo -e "${CYAN}  ==========================================${NC}"
    echo ""
}

list_apps() {
    echo -e "${BLUE}Available Applications:${NC}"
    echo ""
    printf "  ${YELLOW}%-20s %-10s %-12s %s${NC}\n" "NAME" "VERSION" "CATEGORY" "DESCRIPTION"
    echo "  -----------------------------------------------------------------"
    grep -v '^#' "$APP_LIST" | grep -v '^$' | while IFS='|' read -r name version desc category size url; do
        installed=""
        if [ -f "$APP_DATA/$name.installed" ]; then
            installed="${GREEN}[installed]${NC}"
        else
            installed="          "
        fi
        printf "  %-20s %-10s %-12s %s %s\n" "$name" "$version" "$category" "$desc" "$installed"
    done
    echo ""
}

install_app() {
    APP="$1"
    LINE=$(grep "^$APP|" "$APP_LIST" 2>/dev/null)
    
    if [ -z "$LINE" ]; then
        echo -e "${RED}Error: '$APP' not found in app store.${NC}"
        echo "Use 'basic-appcenter list' to see available apps."
        return 1
    fi
    
    NAME=$(echo "$LINE" | cut -d'|' -f1)
    VERSION=$(echo "$LINE" | cut -d'|' -f2)
    DESC=$(echo "$LINE" | cut -d'|' -f3)
    URL=$(echo "$LINE" | cut -d'|' -f6)
    
    if [ -f "$APP_DATA/$NAME.installed" ]; then
        echo -e "${YELLOW}$NAME is already installed.${NC}"
        echo -n "Reinstall? [y/N]: "
        read answer
        [ "$answer" != "y" ] && [ "$answer" != "Y" ] && return 0
    fi
    
    echo -e "${GREEN}Installing $NAME $VERSION...${NC}"
    echo "  $DESC"
    
    mkdir -p "/tmp/app-install-$NAME"
    cd "/tmp/app-install-$NAME"
    
    if wget -q -O "$NAME.tar.gz" "$URL" 2>/dev/null; then
        tar xzf "$NAME.tar.gz" 2>/dev/null
        if [ -d "rootfs" ]; then
            cp -a rootfs/* / 2>/dev/null
        fi
        if [ -f "install.sh" ]; then
            sh install.sh
        fi
        echo "$VERSION" > "$APP_DATA/$NAME.installed"
        echo -e "${GREEN}$NAME $VERSION installed successfully!${NC}"
    else
        echo -e "${RED}Failed to download $NAME.${NC}"
        echo "Check your network connection or try again later."
    fi
    
    cd /
    rm -rf "/tmp/app-install-$NAME"
}

remove_app() {
    APP="$1"
    
    if [ ! -f "$APP_DATA/$APP.installed" ]; then
        echo -e "${YELLOW}$APP is not installed.${NC}"
        return 1
    fi
    
    echo -n "Remove $APP? [y/N]: "
    read answer
    if [ "$answer" != "y" ] && [ "$answer" != "Y" ]; then
        return 0
    fi
    
    rm -f "$APP_DATA/$APP.installed"
    echo -e "${GREEN}$APP removed.${NC}"
}

search_apps() {
    QUERY="$1"
    echo -e "${BLUE}Search results for '$QUERY':${NC}"
    echo ""
    grep -v '^#' "$APP_LIST" | grep -v '^$' | grep -i "$QUERY" | while IFS='|' read -r name version desc category size url; do
        printf "  ${YELLOW}%-20s${NC} %-10s ${CYAN}%-12s${NC} %s\n" "$name" "$version" "$category" "$desc"
    done
    echo ""
}

show_help() {
    echo "Usage: basic-appcenter [command]"
    echo ""
    echo "Commands:"
    echo "  list | ls           List all available apps"
    echo "  install <name>       Install an app"
    echo "  remove <name>        Remove an installed app"
    echo "  search <keyword>     Search for apps"
    echo "  installed            List installed apps"
    echo "  update               Update app list from remote"
    echo "  help                 Show this help"
    echo ""
}

# ====== Main ======

COMMAND="${1:-list}"

case "$COMMAND" in
    list|ls)
        show_banner
        list_apps
        ;;
    install|i)
        [ -z "$2" ] && { echo "Usage: basic-appcenter install <name>"; exit 1; }
        show_banner
        install_app "$2"
        ;;
    remove|rm|uninstall)
        [ -z "$2" ] && { echo "Usage: basic-appcenter remove <name>"; exit 1; }
        show_banner
        remove_app "$2"
        ;;
    search|find)
        [ -z "$2" ] && { echo "Usage: basic-appcenter search <keyword>"; exit 1; }
        show_banner
        search_apps "$2"
        ;;
    installed)
        show_banner
        echo -e "${BLUE}Installed apps:${NC}"
        echo ""
        for f in "$APP_DATA"/*.installed; do
            [ -f "$f" ] || continue
            name=$(basename "$f" .installed)
            ver=$(cat "$f")
            printf "  ${GREEN}%-20s${NC} %s\n" "$name" "$ver"
        done
        echo ""
        ;;
    update)
        echo "Updating app list..."
        wget -q -O "$APP_LIST.new" "$APP_REPO/apps.list" 2>/dev/null && \
            mv "$APP_LIST.new" "$APP_LIST" && \
            echo -e "${GREEN}App list updated!${NC}" || \
            echo -e "${RED}Failed to update.${NC}"
        ;;
    help|--help|-h)
        show_banner
        show_help
        ;;
    *)
        show_banner
        show_help
        ;;
esac