#!/bin/sh
# ================================================
#  basic OS - Init Script (Graphical)
#  Linux Kernel 7.1.6 | BusyBox 1.36.1
# ================================================

# Mount essential filesystems
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run

# Setup hostname
hostname basic

# ---- Installer Mode ----
if grep -q "installer" /proc/cmdline 2>/dev/null; then
    clear
    export TERM=linux
    /usr/sbin/basic-install
    /sbin/reboot -f
fi

# ---- Rescue Mode ----
if grep -q "rescue" /proc/cmdline 2>/dev/null; then
    clear
    echo ">>> basic OS Rescue Mode <<<"
    echo "Type 'exit' to reboot."
    exec /bin/sh
fi

# ---- Text Mode (no desktop) ----
if grep -q "text" /proc/cmdline 2>/dev/null; then
    clear
    echo ""
    echo "  =========================================="
    echo "     ___           _         ___  ____  "
    echo "    | _ ) __ _ __ (_)__ ___ / _ \\/ ___\\ "
    echo "    | _ \\/ _\` / _|| / _/ __| (_) \\___ \\ "
    echo "    |___/\\__,_\\__||_\\__\\___|\\___/|____/ "
    echo "  =========================================="
    echo "          Linux Kernel 7.1.6"
    echo "  =========================================="
    echo ""
    echo "Type 'basic-appcenter' or 'basic-install'"
    echo "Type 'desktop' to start graphical desktop"
    echo ""
    exec /bin/sh
fi

# ---- Normal boot: try framebuffer desktop ----
if [ -c /dev/fb0 ]; then
    echo "Starting basic OS Desktop..."
    /usr/bin/basic-desktop
    echo "Desktop exited. Starting shell..."
    exec /bin/sh
fi

# ---- Fallback to shell ----
clear
echo "Welcome to basic OS!"
echo "Type 'basic-appcenter' or 'basic-install'"
exec /bin/sh