#!/bin/sh
# ================================================
#  basic OS - Graphical Installer (dialog)
# ================================================

export TERM=linux
DIALOG="/usr/bin/dialog"
BACKTITLE="basic OS Installer | Linux Kernel 7.1.6"

# ---- Welcome ----
$DIALOG --backtitle "$BACKTITLE" --title "basic OS Installer" \
  --msgbox "\nWelcome to basic OS!\n\nThis installer will guide you through\ninstalling basic OS to your hard disk.\n\nWARNING: This will ERASE ALL DATA on\nthe selected disk.\n\nPress ENTER to continue or ESC to cancel." 14 55

[ $? -ne 0 ] && exit 0

# ---- Select Disk ----
DISKS=""
for d in /dev/sd? /dev/vd? /dev/nvme?n?; do
    [ -b "$d" ] || continue
    SIZE=$(fdisk -l "$d" 2>/dev/null | grep "^Disk $d" | awk '{printf "%s %s",$3,$4}' | tr -d ',')
    DISKS="$DISKS $d \"$SIZE\" off"
done

if [ -z "$DISKS" ]; then
    $DIALOG --backtitle "$BACKTITLE" --title "Error" \
      --msgbox "No disks found!" 6 40
    exit 1
fi

TARGET=$(eval $DIALOG --backtitle \"$BACKTITLE\" --title \"Select Target Disk\" \
  --radiolist \"\\nChoose a disk to install basic OS:\\n\" 14 55 5 $DISKS 2>&1 >/dev/tty)

[ -z "$TARGET" ] && exit 0

# ---- Confirmation ----
$DIALOG --backtitle "$BACKTITLE" --title "Confirm" \
  --yesno "\nYou are about to ERASE ALL DATA on:\n\n    $TARGET\n\nAre you ABSOLUTELY sure?\n\nThis cannot be undone!" 13 55

[ $? -ne 0 ] && { $DIALOG --backtitle "$BACKTITLE" --title "Cancelled" --msgbox "Installation cancelled." 6 40; exit 0; }

# ---- Choose Hostname ----
HOSTNAME=$($DIALOG --backtitle "$BACKTITLE" --title "Hostname" \
  --inputbox "Enter hostname:" 8 40 "basic" 2>&1 >/dev/tty)
[ -z "$HOSTNAME" ] && HOSTNAME="basic"

# ---- Partitioning ----
$DIALOG --backtitle "$BACKTITLE" --title "Installing" \
  --gauge "Partitioning $TARGET..." 6 50 0

(
echo "10"; sleep 0.3
echo "XXX"; echo "Creating partition table..."; echo "XXX"
sfdisk "$TARGET" --wipe always >/dev/null 2>&1 <<EOF
label: dos
size=256M, type=83, bootable
type=83
EOF
echo "25"; sleep 0.3

# Determine partitions
if echo "$TARGET" | grep -q "nvme"; then
    BOOTPART="${TARGET}p1"
    ROOTPART="${TARGET}p2"
else
    BOOTPART="${TARGET}1"
    ROOTPART="${TARGET}2"
fi

echo "XXX"; echo "Formatting partitions..."; echo "XXX"
echo "40"; sleep 0.5
mkfs.ext4 -F "$ROOTPART" >/dev/null 2>&1
echo "60"; sleep 0.3
mkfs.ext4 -F "$BOOTPART" >/dev/null 2>&1

echo "XXX"; echo "Mounting filesystems..."; echo "XXX"
echo "70"; sleep 0.3
mkdir -p /mnt/root /mnt/boot
mount "$ROOTPART" /mnt/root
mount "$BOOTPART" /mnt/boot

echo "XXX"; echo "Copying system files..."; echo "XXX"
echo "80"; sleep 0.5
mkdir -p /mnt/root/{dev,proc,sys,tmp,run,mnt,var/log,etc,usr,root,boot}
for d in bin sbin usr; do
    cp -a /$d /mnt/root/ 2>/dev/null
done
cp -a /etc/* /mnt/root/etc/ 2>/dev/null || true

echo "XXX"; echo "Creating init script..."; echo "XXX"
cat > /mnt/root/init << 'INITEOF'
#!/bin/sh
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp && mount -t tmpfs tmpfs /run
hostname REPLACE_HOST
echo "Welcome to basic OS!" | dialog --backtitle "basic OS" --title "Welcome" --msgbox -- 6 40
exec /bin/sh
INITEOF
sed -i "s/REPLACE_HOST/$HOSTNAME/" /mnt/root/init
chmod +x /mnt/root/init

cp /boot/vmlinuz-basic /mnt/boot/vmlinuz 2>/dev/null

echo "XXX"; echo "Installing bootloader..."; echo "XXX"
echo "90"; sleep 0.5
mkdir -p /mnt/boot/syslinux
cp /usr/lib/syslinux/modules/bios/menu.c32 /mnt/boot/syslinux/ 2>/dev/null || true
cp /usr/lib/syslinux/modules/bios/libutil.c32 /mnt/boot/syslinux/ 2>/dev/null || true
cp /usr/lib/syslinux/modules/bios/libcom32.c32 /mnt/boot/syslinux/ 2>/dev/null || true

ROOTUUID=$(blkid -s UUID -o value "$ROOTPART" 2>/dev/null || echo "$ROOTPART")
cat > /mnt/boot/syslinux/syslinux.cfg << SYSEOF
DEFAULT basic
TIMEOUT 30
PROMPT 0
LABEL basic
    MENU LABEL basic OS
    LINUX /vmlinuz
    APPEND root=UUID=$ROOTUUID rw quiet
SYSEOF

dd if=/usr/lib/syslinux/modules/bios/mbr.bin of="$TARGET" bs=440 count=1 2>/dev/null || true
extlinux --install /mnt/boot/syslinux 2>/dev/null || true

cat > /mnt/root/etc/fstab << FSTABEOF
UUID=$ROOTUUID / ext4 defaults 0 1
proc /proc proc defaults 0 0
FSTABEOF

echo "XXX"; echo "Unmounting..."; echo "XXX"
echo "95"; sleep 0.3
umount /mnt/boot
umount /mnt/root

echo "100"
) | $DIALOG --backtitle "$BACKTITLE" --title "Installing" \
  --gauge "\nInstalling basic OS to $TARGET...\n" 8 50 0

# ---- Done ----
$DIALOG --backtitle "$BACKTITLE" --title "Installation Complete" \
  --msgbox "\nbasic OS has been installed!\n\n  Hostname: $HOSTNAME\n  Disk:     $TARGET\n\nRemove the installation media and\nreboot to start using basic OS." 13 55

$DIALOG --backtitle "$BACKTITLE" --title "Reboot" \
  --yesno "Reboot now?" 6 40
[ $? -eq 0 ] && reboot -f